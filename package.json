{
	"name": "developer-toolbox",
	"version": "0.10.6",
	"description": "Capture annotated screenshots and structured issue context for AI-assisted plugin development.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings 0 && prettier --check \"**/*.ts\" && node scripts/check-submission.mjs && npm run typecheck:marketplace",
		"test": "vitest run",
		"typecheck:marketplace": "tsc --noEmit -p tsconfig.scan.json",
		"knip": "knip",
		"type-coverage": "type-coverage",
		"test:mutation": "stryker run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky"
	},
	"typeCoverage": {
		"atLeast": 99
	},
	"keywords": [],
	"author": "Charles Kelsoe",
	"license": "MIT",
	"dependencies": {
		"konva": "^10.0.0"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^24.0.7",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"globals": "^17.1.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"knip": "^6.32.0",
		"obsidian": "^1.14.4",
		"prettier": "^3.9.6",
		"tslib": "^2.8.1",
		"type-coverage": "^2.30.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"brace-expansion@1": "^1.1.21",
		"brace-expansion@2": "^2.1.7",
		"brace-expansion@5": "^5.0.12",
		"browserslist": "^4.28.7",
		"fast-uri": "^3.1.9",
		"flatted": "^3.4.0",
		"glob": "^14.0.3",
		"handlebars": "^4.7.10",
		"js-yaml": "^4.3.2",
		"moment": "^2.31.0",
		"picomatch": "^2.3.2",
		"qs": "^6.16.1",
		"smol-toml": "^1.9.0",
		"test-exclude": "^8.0.0",
		"zod": "^4.6.6",
		"minimatch@9": "^11.0.8",
		"minimatch@10": "^11.0.8"
	}
}
